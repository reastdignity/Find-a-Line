# The settings of the public site, read by both services (compose.yaml: env_file). Copy to
# findaline.env (git-ignored) and fill in. Secrets do not go here but into ./secrets/.

# Address of the site (https://...), the reverse proxy in front of it, and the operator's
# contact (sent in the User-Agent to Nominatim, Overpass and the data services)
FINDALINE_PUBLIC_URL=https://findaline.example.org
# FINDALINE_TRUSTED_PROXY: SWAG's fixed address in the network findaline-proxy (docs/deployment.md)
FINDALINE_TRUSTED_PROXY=172.30.0.2
FINDALINE_CONTACT=you@example.org
#FINDALINE_CONCURRENCY=400

# Sign-in (their secrets: secrets/findaline_github_client_secret, ..._google_client_secret)
#FINDALINE_GITHUB_CLIENT_ID=
#FINDALINE_GOOGLE_CLIENT_ID=
#FINDALINE_ADMINS=github:12345
#FINDALINE_SIGNUP=approval

# Limits (README, "Limits of the web app"): unset = the public site's values, "none" = no limit.
# The time limits below are those values (seconds): a search's download and computing, an
# OpenStreetMap extract, an estimate or a profile; uncomment one only to change it
#FINDALINE_LIMIT_DOWNLOAD_SECONDS=3600
#FINDALINE_LIMIT_COMPUTE_SECONDS=7200
#FINDALINE_LIMIT_OSM_SECONDS=7200
#FINDALINE_LIMIT_QUICK_SECONDS=120
