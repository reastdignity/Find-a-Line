# Variables of compose.yaml itself (not passed to the app as a whole). Copy to .env next to
# compose.yaml (git-ignored); every one has a default.

# Resources of the services; WORKER_CPUS: the number of cores minus one (at most the number of cores)
#WEB_CPUS=1
#WEB_MEMORY=1g
#WORKER_CPUS=3
#WORKER_MEMORY=8g

# The local mirror of the Slovak tiles: an absolute path to the folder above slovakia/
#FINDALINE_MIRROR_DIR=/srv/findaline-mirror

# OpenTopography API key for --source nasadem (the worker only)
#OPENTOPOGRAPHY_API_KEY=
