# Variables of compose.yaml itself (not passed to the app as a whole). Copy to .env next to
# compose.yaml (git-ignored); every one has a default.

# Resources of the services; WORKER_CPUS: the number of cores minus one (a whole number, at most the
# number of cores; also the worker's numba threads)
#WEB_CPUS=1
#WEB_MEMORY=1g
#WORKER_CPUS=3
#WORKER_MEMORY=8g

# The host's port of the web service, on 127.0.0.1 only (nginx's upstream in
# deploy/nginx/findaline-http.conf names it too)
#WEB_PORT=8765

# The local mirror of the Slovak tiles: an absolute path to the folder above slovakia/
#FINDALINE_MIRROR_DIR=/srv/findaline-mirror

# DNS resolvers of both services (public ones by default: the firewall keeps the containers
# away from private addresses, where the provider's resolver often is)
#CONTAINER_DNS_1=9.9.9.9
#CONTAINER_DNS_2=1.1.1.1
